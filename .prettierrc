{
  "tabWidth": 4,
  "semi": false,
  "printWidth": 100,
  "arrowParens": "avoid",
  "trailingComma": "none",
  "bracketSameLine": false,
  "singleAttributePerLine": true,
  "overrides": [
    {
      "files": "*{.json,.yaml,.yml,.prettierrc}",
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
